{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "RePrint API (Fastify) and background worker",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @reprint/shared build && pnpm run --parallel \"/^dev:/\"",
    "build": "tsc -p tsconfig.build.json && tsx src/scripts/openapi.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "seed:admin": "tsx --env-file-if-exists=../../.env src/scripts/seed-admin.ts",
    "seed:catalog": "tsx --env-file-if-exists=../../.env src/scripts/seed-catalog.ts",
    "seed:reviews": "tsx --env-file-if-exists=../../.env src/scripts/seed-reviews.ts",
    "seed:discover": "tsx --env-file-if-exists=../../.env src/scripts/seed-discover.ts",
    "seed:libraries": "tsx --env-file-if-exists=../../.env src/scripts/seed-libraries.ts",
    "fixtures:record": "tsx src/catalog/sources/open-library/record-fixtures.ts",
    "openapi:check": "tsx src/scripts/openapi.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@reprint/db": "workspace:*",
    "@reprint/email": "workspace:*",
    "@reprint/shared": "workspace:*",
    "@sentry/node": "^11.1.0",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.12",
    "pino": "^10.3.1",
    "resend": "~6.30.0",
    "sharp": "^0.35.5",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@reprint/config": "workspace:*",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
