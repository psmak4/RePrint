{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "RePrint API (Fastify) and background worker",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @reprint/shared build && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@reprint/db": "workspace:*",
    "@reprint/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@reprint/config": "workspace:*",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
