# RePrint environment variables
#
# Copy to `.env` for local development (never commit `.env`). Values below are
# LOCAL defaults matching docker-compose.yml, or placeholders. Staging and production
# values live only in Render, Netlify, and GitHub settings (PRD §11).
# Every variable is validated with Zod at startup; a missing required value fails fast.

# ---------------------------------------------------------------------------
# Shared (API, worker, web server, scripts)
# ---------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
APP_ENV=local                        # local | preview | staging | production
LOG_LEVEL=info                       # pino level

# Domains (D-013). Nothing hard-codes reprint.com.
WEB_ORIGIN=http://www.reprint.localhost:5173
API_ORIGIN=http://api.reprint.localhost:3000
# Origins allowed to send non-GET requests (PRD §10). Comma-separated; add preview/staging web origins there.
WEB_ORIGINS=http://www.reprint.localhost:5173,http://localhost:5173
COOKIE_DOMAIN=reprint.localhost      # production: reprint.com
IMAGE_BASE_URL=http://api.reprint.localhost:3000/v1/uploads   # production: https://img.reprint.com

# ---------------------------------------------------------------------------
# Database (packages/db, apps/api)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://reprint:reprint@localhost:5432/reprint
# Optional: a separate direct (non-pooled) URL for migrations on Neon.
DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# API + worker (apps/api)
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0                         # API listen address
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false                    # true behind Render's load balancer (correct client IPs)
WORKER_IN_PROCESS=false              # true runs the job worker inside the API (free-tier staging only, D-071)

# Sessions (PRD §8). Cookie name is fixed: rp_session.
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                  # unset = on unless APP_ENV=local; true everywhere except local http

# Registration (D-014, PRD §7.1)
PUBLIC_SIGNUPS=false                 # false = private beta, invite code required
SIGNUP_INVITE_CODES=local-beta       # comma-separated invite codes
HIBP_MODE=off                        # live | off (breached-password range API, D-029)

# Book Source (PRD §6, §13)
SOURCE_MODE=fixtures                 # fixtures | live | stub
SOURCE_RATE_LIMIT_RPS=2              # production 2, staging 1
SOURCE_TIMEOUT_MS=5000               # full Book fetch limit
SOURCE_SEARCH_TIMEOUT_MS=1500        # search waits this long before showing Catalog-only results
SOURCE_CONTACT_EMAIL=ops@reprint.com # sent in User-Agent: RePrint/<version> (<email>)
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_COVERS_BASE_URL=https://covers.openlibrary.org

# Email (PRD §7.12, D-028)
EMAIL_TRANSPORT=smtp                 # smtp (Mailpit locally) | resend
EMAIL_FROM="RePrint <no-reply@reprint.localhost>"   # production: no-reply@mail.reprint.com
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=                      # staging/production/preview only

# File storage (PRD §6, §7.8, D-030)
STORAGE_DRIVER=local                 # local | r2
STORAGE_LOCAL_DIR=.data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=
UPLOAD_MAX_BYTES=5242880             # 5 MB (PRD §11)

# Observability (PRD §11)
SENTRY_DSN=                          # empty = Sentry disabled
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1        # 0 to 1

# Mailpit API, used by e2e tests to read captured email
MAILPIT_API_URL=http://localhost:8025

# ---------------------------------------------------------------------------
# Web (apps/web). VITE_* values are exposed to the browser; never put secrets there.
# ---------------------------------------------------------------------------
WEB_PORT=5173
API_INTERNAL_URL=http://localhost:3000        # server-side loader calls (SSR)
VITE_API_ORIGIN=http://api.reprint.localhost:3000   # browser calls for interactive changes
VITE_SENTRY_DSN=                              # empty = disabled (web server and browser)
VITE_SENTRY_ENVIRONMENT=                      # defaults to APP_ENV on the server
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_ANALYTICS_DOMAIN=                        # empty = analytics off (D-049)
VITE_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js

# ---------------------------------------------------------------------------
# Build and CI only (set as GitHub Actions secrets, not in .env)
# ---------------------------------------------------------------------------
# TURBO_TOKEN=                 # optional Turborepo remote cache
# TURBO_TEAM=
# SENTRY_AUTH_TOKEN=           # source map upload
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=
# SENTRY_PROJECT_API=
# STAGING_DATABASE_URL_DIRECT= # migrations on merge to main (docs/deploy.md lists every deploy secret)
# RENDER_DEPLOY_HOOK_API_STAGING=      # Render deploy hook URLs (include ?key=...)
# RENDER_DEPLOY_HOOK_WORKER_STAGING=   # optional when the API runs the worker in process
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# PRODUCTION_DATABASE_URL=     # release workflow and backups (M8)
# R2_BUCKET_BACKUPS=
